{
  "name": "react-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix": "eslint \"src\" --ext .ts,.tsx,.js,.jsx --fix",
    "lint:root": "eslint \"*.{ts,tsx,mjs,json,mts}\"",
    "lint:config:fix": "eslint \"*.{ts,tsx,mjs,json,mts}\" --fix",
    "format": "prettier --loglevel warn --write \"./**/*.{js,jsx,ts,tsx,css,md,json}\" --ignore-path .prettierignore",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "pre-commit": "pretty-quick --staged",
    "prepare-commit-msg": "sh tools/git-commit-message.sh .git/COMMIT_EDITMSG",
    "upgrade": "pnpm up --latest --interactive",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-accessible-icon": "^1.1.15",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-form": "^0.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@reduxjs/toolkit": "^2.12.0",
    "@site8/shared": "file:../shared",
    "@tanstack/react-query": "^5.101.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "aws-amplify": "^6.20.0",
    "baseline-browser-mapping": "^2.11.18",
    "brace-expansion": "^5.0.9",
    "caniuse-lite": "^1.0.30001809",
    "date-fns": "^4.4.0",
    "html-react-parser": "^6.1.7",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-i18next": "^17.0.12",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "storybook": "^10.5.10",
    "styled-components": "^6.5.3",
    "valibot": "^1.4.2",
    "web-vitals": "^6.1.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@storybook/react": "^10.5.10",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/amplify": "^1.1.28",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-react-redux": "^4.2.2",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "react-scan": "^0.5.7",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-bundle-analyzer": "^1.3.9",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@tanstack/eslint-plugin-query": {
      "typescript": "$typescript"
    },
    "react-scan": {
      "esbuild": "0.28.0"
    },
    "@xstate/react@3.2.2": {
      "react": "$react"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all",
    "last 2 versions",
    "maintained node versions"
  ],
  "sideEffects": false,
  "packageManager": "npm@11.10.0",
  "license": "UNLICENSED",
  "allowScripts": {
    "unrs-resolver": true,
    "msgpackr-extract": true,
    "esbuild": true
  }
}
